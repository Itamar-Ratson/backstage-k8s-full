%% Where each Backstage core concept physically lands in this repo's deployment.
flowchart LR
  classDef github fill:#24292f,stroke:#000,color:#fff
  classDef cluster fill:#1a4d6e,stroke:#0d3a57,color:#fff
  classDef store fill:#b0722a,stroke:#8a5820,color:#fff
  classDef person fill:#e8e8f8,stroke:#888,color:#000

  dev(["Developer"]):::person

  subgraph KIND["Kubernetes cluster (KinD)"]
    direction TB
    gw["Envoy Gateway<br/>backstage.localtest.me"]:::cluster
    bs["Backstage pod<br/>app-config.yaml (baked)<br/>+ runtime ConfigMap"]:::cluster
    argocd["Argo CD"]:::cluster
    pg[("Postgres")]:::store
    k8s["Kubernetes API"]:::cluster
  end

  subgraph GH["GitHub"]
    direction TB
    repo["Monorepo<br/>catalog-info.yaml files<br/>templates/ + charts/ + deploy/"]:::github
    gha["GitHub Actions<br/>builds Backstage image"]:::github
    ghcr[("GHCR<br/>image registry")]:::store
  end

  dev --> gw
  gw --> bs
  bs --> pg
  bs -- "Kubernetes plugin<br/>reads live workloads" --> k8s
  bs -- "catalog discovery: **/*catalog-info.yaml<br/>TechDocs source: docs/ + mkdocs.yaml<br/>scaffolder opens PRs (GitHub App)" --> repo
  argocd -- "watches charts/ + deploy/" --> repo
  argocd -- "syncs Helm releases" --> bs
  gha -- "push image" --> ghcr
  gha -- "bump image tag in deploy/dev/" --> repo
